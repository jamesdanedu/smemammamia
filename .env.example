# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit the real values.

# ===========================================================================
#  REQUIRED — the site cannot take a booking without these
# ===========================================================================

# --- Supabase (Project Settings → API) -------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...          # secret! server side only

# --- SumUp (Developer settings → API keys) ---------------------------------
SUMUP_API_KEY=sup_sk_...
SUMUP_MERCHANT_CODE=MXXXXXXX

# --- Admin page ------------------------------------------------------------
ADMIN_PASSWORD=choose-something-long


# ===========================================================================
#  CONFIRMATION EMAILS — required if you want customers to get anything
# ===========================================================================

# The address customers see. MUST be on a domain you have verified with the
# provider below. A gmail.com or school address you don't control the DNS for
# will be rejected or land in spam.
#
# The domain here is the site's own domain. Spell it out and check it against
# the domain list in the provider: a near miss (smemammia.com for
# smemammamia.com) is accepted here, then refused at send time with a 403 that
# reads like a key problem rather than a typo.
EMAIL_FROM="Mamma Mia! <tickets@smemammamia.com>"

# Where replies to confirmation emails go
EMAIL_REPLY_TO=smehighschoolmusical@gmail.com

# Where the contact form (contact.html) sends questions. Reply-To is set to
# the person asking, so you answer by pressing Reply. [smehighschoolmusical@gmail.com]
ENQUIRIES_TO=smehighschoolmusical@gmail.com

# Optional: blind copy of every confirmation, so the office has a record
EMAIL_BCC=musical@stmarysedenderry.ie

# At least one provider. Set BOTH and a single provider outage cannot stop
# confirmations — the second one picks up automatically.
RESEND_API_KEY=re_...
BREVO_API_KEY=xkeysib-...

# Protects /api/reconcile, the scheduled job that rescues abandoned payments
# and retries unsent emails. Any long random string.
CRON_SECRET=some-long-random-string

# Your live URL, used for links inside emails. Without it the site guesses
# from the request, which is usually right but not on a custom domain.
# The value below is an EXAMPLE ONLY — replace it with the real deployed URL
# for this show (the Vercel URL, or your own domain once it is pointed at it).
SITE_URL=https://mammamiathemusical.ie


# ===========================================================================
#  OPTIONAL — defaults in brackets
# ===========================================================================
TICKET_PRICE=15            # [15]  euro per ticket — must match config.js
HOLD_MINUTES=15            # [15]  how long tickets are reserved at checkout
MAX_PER_ORDER=10           # [10]  most tickets in one booking
WALL_AUTO_APPROVE=false    # [false] true = wall messages appear without moderation

# Shown in confirmation emails. Defaults match config.js — set these only if
# you want to correct a time without redeploying.
SHOW_NAME="Mamma Mia!"
SHOW_SCHOOL="St Mary's Secondary School, Edenderry"
SHOW_VENUE="St Mary's Secondary School, Edenderry, Co. Offaly"
SHOW_DOORS=7:00 PM
SHOW_CURTAIN=7:30 PM
